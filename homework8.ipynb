class Stack():
    def __init__(self,stack):
        self.stack = []
    def push(self,x):
        self.stack.append(x)
    def pop(self):
        if self.stack:
            self.stack.pop()
    def top(self):
        return self.stack[-1]
    
n = int(input())
alo = Stack([])
for i in range(0,n):
    c = input().split()
    if c[0] == "PUSH":
        alo.push(c[-1])
    if c[0] == "POP":
        alo.pop()
    if c[0] == "TOP":
        print(alo.top())
